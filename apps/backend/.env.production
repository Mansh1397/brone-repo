NODE_ENV=production
PORT=8080

# DATABASE CONNECTION POOL BALANCING
PGHOST=production-db-cluster.internal
PGPORT=5432
PGUSER=brone_admin
PGDATABASE=brone_prod
PGPOOL_SIZE=20
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=5000

# EDGE PERIMETER HANDSHAKE SECRET
EDGE_SECRET_HMAC=PLACEHOLDER_64_CHARACTER_HEX_STRING_MANAGED_VIA_VAULT

# MASTER CRYPTOGRAPHIC DOMAIN BINDINGS
SERVER_PRIVATE_KEY_D=PLACEHOLDER_PRIVATE_KEY_EXPONENT_D
SERVER_PRIVATE_KEY_N=PLACEHOLDER_PRIVATE_KEY_MODULUS_N
